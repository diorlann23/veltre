# MongoDB connection string. Local: mongodb://127.0.0.1:27017  Atlas: mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=veltre

# Public URL of the site (no trailing slash). Used for metadata and request origin checks.
APP_URL=http://localhost:3000

# Comma-separated emails that become admins when they register (or run `npm run create-admin`).
ADMIN_EMAILS=
